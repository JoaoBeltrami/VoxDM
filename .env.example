# Obrigatórias — copiar para .env e preencher
GROQ_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
NEO4J_URI=
NEO4J_USER=          # username do AuraDB (não é neo4j — ver Connection Details)
NEO4J_PASSWORD=

# API — binding e CORS
# Em LAN compartilhada (casa, escritório), manter 127.0.0.1 — qualquer um com
# acesso à rede consegue chegar na API se for 0.0.0.0. Use Cloudflare Tunnel
# para expor publicamente; o tunnel se conecta ao localhost.
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Multi-provider LLM (cascata de fallback) ─────────────────────────────
# Cascata default: Groq 70B → Groq 8B → Gemini → Cerebras → Ollama.
# Provider sem chave/serviço é silenciosamente pulado pelo router.

# Modelo Groq secundário — usado quando o 70B estoura TPD (quota separada).
# Modelo de RACIOCÍNIO: o provider passa reasoning_effort=low automaticamente.
# (llama-3.1-8b-instant foi desligado pelo Groq em 16/08/2026)
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# Gemini — pegue chaves free em https://aistudio.google.com/apikey
# Free tier por projeto: 1500 req/dia. CADA PROJETO TEM QUOTA SEPARADA.
# Multi-key: crie 2-3 chaves em PROJETOS DIFERENTES (no diálogo "Create API
# key" clique "Create project [nome]" pra cada uma) e passe separadas por
# vírgula. 3 projetos = 4500 RPD ≈ infinito pra single-player.
GEMINI_API_KEYS=
# Legado — usado se GEMINI_API_KEYS estiver vazio (uma chave só).
GEMINI_API_KEY_V2=
# Multi-model: cada modelo Gemini tem cota separada por projeto. Quando o
# 1º estoura, o provider tenta o 2º antes de cascatear pra Groq/Ollama.
# IMPORTANTE: usar variantes "-lite" ou "-latest". O gemini-2.5-flash "full"
# tem thinking budget que come o max_tokens antes do output visível.
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite

# Timeout por tentativa de provider (segundos)
LLM_PROVIDER_TIMEOUT=30.0

# Ollama (último fallback — local, sem rate limit)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HEALTH_TIMEOUT=3.0

# Opcionais
WANDB_API_KEY=
LOG_LEVEL=INFO
# Beat de turno inimigo (Pilar Perigo): a engine roda uma 2ª chamada LLM curta
# narrando o turno dos inimigos após cada ação de combate do jogador.
# Se atrapalhar (latência/duplicação), desligue sem rollback:
# BEAT_INIMIGO_ATIVO=false
BEAT_INIMIGO_ATIVO=true
# DEBUG=true expõe /debug/* (introspection da engine) e ativa --reload do uvicorn.
# NUNCA habilitar em produção. Default false já é seguro.
DEBUG=false
DEFAULT_MODULE_PATH=./modulo_teste/modulo_teste_v1.2.json
SRD_DATA_DIR=./srd_data
QDRANT_COLECAO_RULES=voxdm_rules

# ── Auth (Cloudflare Access Zero Trust) ───────────────────────────────────
# Em DEBUG=true (dev local), DEV_USER_EMAIL é usado como identidade default.
# Em produção (DEBUG=false), o header Cf-Access-Authenticated-User-Email do
# Cloudflare manda — DEV_USER_EMAIL é ignorado.
# ADMIN_EMAILS: CSV de emails com acesso a /debug/* e visualização cross-tenant.
# AMBOS devem ser configurados aqui — não no código (privacy).
DEV_USER_EMAIL=admin@localhost
ADMIN_EMAILS=admin@localhost
CF_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Legado — não mais obrigatório, mantido para retrocompatibilidade
GEMINI_API_KEY=          # free tier extinto; não usado na engine
LANGCHAIN_API_KEY=       # LangSmith tracing; não usado na engine

# ── Feature flags da engine (kill-switches) ───────────────────────────────
# GRIMDARK_ATIVO=true liga a rota de ficcao sombria: dm_profile="sombrio" ou
# keywords de atrocidade roteiam NARRATIVE_GRIM (70b -> gemini -> ollama-grim)
# com deteccao de amarelada + reframe. Requer o modelo local puxado:
#   ollama pull dolphin-mistral
GRIMDARK_ATIVO=false
OLLAMA_MODEL_GRIM=dolphin-mistral
# Dossie de personalidade por NPC (2-3 tracos gerados no 1o encontro, 8B,
# fire-and-forget). false = rollback instantaneo.
DOSSIE_NPC_ATIVO=true
# NarrationBrief como fonte do prompt (tese LLM-fino) — DEFAULT ON desde 19/07
# (ADR-001; A/B: tokens -47%, qualidade nao-inferior). Troca o dump do
# para_texto pelo briefing enxuto. Rollback: descomentar com false.
# BRIEF_ATIVO=false
