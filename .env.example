# Obrigatórias — copiar para .env e preencher
GROQ_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
NEO4J_URI=
NEO4J_USER=          # username do AuraDB (não é neo4j — ver Connection Details)
NEO4J_PASSWORD=

# API — binding e CORS
# Em LAN compartilhada (casa, escritório), manter 127.0.0.1 — qualquer um com
# acesso à rede consegue chegar na API se for 0.0.0.0. Use Cloudflare Tunnel
# para expor publicamente; o tunnel se conecta ao localhost.
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Multi-provider LLM (cascata de fallback) ─────────────────────────────
# Cascata default: Groq 70B → Groq 8B → Gemini → Cerebras → Ollama.
# Provider sem chave/serviço é silenciosamente pulado pelo router.

# Modelo Groq secundário — usado quando o 70B estoura TPD (quota separada).
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

# Gemini — pegue chaves free em https://aistudio.google.com/apikey
# Free tier por projeto: 1500 req/dia. CADA PROJETO TEM QUOTA SEPARADA.
# Multi-key: crie 2-3 chaves em PROJETOS DIFERENTES (no diálogo "Create API
# key" clique "Create project [nome]" pra cada uma) e passe separadas por
# vírgula. 3 projetos = 4500 RPD ≈ infinito pra single-player.
GEMINI_API_KEYS=
# Legado — usado se GEMINI_API_KEYS estiver vazio (uma chave só).
GEMINI_API_KEY_V2=
# Multi-model: cada modelo Gemini tem cota separada por projeto. Quando o
# 1º estoura, o provider tenta o 2º antes de cascatear pra Groq/Ollama.
# IMPORTANTE: usar variantes "-lite" ou "-latest". O gemini-2.5-flash "full"
# tem thinking budget que come o max_tokens antes do output visível.
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite

# Timeout por tentativa de provider (segundos)
LLM_PROVIDER_TIMEOUT=30.0

# Ollama (último fallback — local, sem rate limit)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HEALTH_TIMEOUT=3.0

# Opcionais
WANDB_API_KEY=
LOG_LEVEL=INFO
# DEBUG=true expõe /debug/* (introspection da engine) e ativa --reload do uvicorn.
# NUNCA habilitar em produção. Default false já é seguro.
DEBUG=false
DEFAULT_MODULE_PATH=./modulo_teste/modulo_teste_v1.2.json
SRD_DATA_DIR=./srd_data
QDRANT_COLECAO_RULES=voxdm_rules

# Legado — não mais obrigatório, mantido para retrocompatibilidade
GEMINI_API_KEY=          # free tier extinto; não usado na engine
LANGCHAIN_API_KEY=       # LangSmith tracing; não usado na engine
